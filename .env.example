# Copy to .env (gitignored) and fill in real values, then run:
#   pnpm seed-secrets --environment staging
# This never touches your .env values except to push them into AWS Secrets
# Manager for the given environment; the deployed worker/Lambdas only ever
# read secrets from Secrets Manager, never from environment variables
# directly.

# Slack bot token (xoxb-...) for the dedicated cost-agent Slack app
# (docs/adr/0001-dedicated-bot-and-readonly-boundary.md). Only needed once
# harness.yaml's slack.enabled is true.
SLACK_BOT_TOKEN=

# Slack app signing secret (from api.slack.com > Basic Information). Verifies
# inbound Events API requests for the app_mention trigger
# (apps/functions/slack-events).
SLACK_SIGNING_SECRET=

# Only needed if harness.yaml's model.provider is "anthropic" instead of the
# default "litellm" (docs/adr/0002-litellm-model-gateway.md).
ANTHROPIC_API_KEY=

# LiteLLM gateway master/virtual key (docs/adr/0002-litellm-model-gateway.md).
# Only needed if harness.yaml's model.provider is "litellm" (the default).
LITELLM_MASTER_KEY=
