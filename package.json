{
  "name": "paco-cost-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cdk:deploy": "cdk deploy --app 'tsx apps/infra/bin/infra.ts'",
    "cdk:diff": "cdk diff --app 'tsx apps/infra/bin/infra.ts'",
    "cdk:synth": "cdk synth --app 'tsx apps/infra/bin/infra.ts'",
    "clean": "rimraf dist coverage cdk.out",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "seed-secrets": "tsx scripts/seed-secrets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.274",
    "@aws-sdk/client-cloudtrail": "3.879.0",
    "@aws-sdk/client-cloudwatch": "3.879.0",
    "@aws-sdk/client-compute-optimizer": "3.879.0",
    "@aws-sdk/client-cost-explorer": "3.879.0",
    "@aws-sdk/client-dynamodb": "3.879.0",
    "@aws-sdk/client-ec2": "3.879.0",
    "@aws-sdk/client-ecs": "3.879.0",
    "@aws-sdk/client-lambda": "3.879.0",
    "@aws-sdk/client-rds": "3.879.0",
    "@aws-sdk/client-s3": "3.879.0",
    "@aws-sdk/client-secrets-manager": "3.879.0",
    "@aws-sdk/client-sfn": "3.879.0",
    "@aws-sdk/client-sqs": "3.879.0",
    "@aws-sdk/client-sts": "3.879.0",
    "@aws-sdk/lib-dynamodb": "3.879.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "aws-cdk-lib": "2.215.0",
    "constructs": "10.4.2",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.1",
    "@vitest/coverage-v8": "3.2.4",
    "aws-cdk": "2.1142.0",
    "esbuild": "0.25.9",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
